#!/usr/bin/env bash
# Pre-commit hook: validates staged files before commit
set -euo pipefail

ERRORS=0

# 1. Check for secrets in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$STAGED_FILES" ]; then
    # Check for hardcoded secrets patterns
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            if grep -qE "(sk-[a-zA-Z0-9]{20,}|AKIA[A-Z0-9]{16}|ghp_[a-zA-Z0-9]{36}|glpat-[a-zA-Z0-9\-]{20,})" "$file" 2>/dev/null; then
                echo "ERROR: Potential secret detected in $file"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done

    # 2. Check for .env files being committed
    for file in $STAGED_FILES; do
        if echo "$file" | grep -qE "^\.env$|^\.env\..+$|\.env\.local$"; then
            echo "ERROR: Environment file staged for commit: $file"
            ERRORS=$((ERRORS + 1))
        fi
    done

    # 3. Validate JSON files
    for file in $STAGED_FILES; do
        if echo "$file" | grep -qE "\.json$"; then
            if [ -f "$file" ]; then
                if ! node -e "JSON.parse(require('fs').readFileSync('$file','utf8'))" 2>/dev/null; then
                    echo "ERROR: Invalid JSON: $file"
                    ERRORS=$((ERRORS + 1))
                fi
            fi
        fi
    done

    # 4. Check for debug statements in JS files
    for file in $STAGED_FILES; do
        if echo "$file" | grep -qE "\.(js|mjs)$"; then
            if [ -f "$file" ]; then
                if grep -nE "^\s*(debugger|console\.debug)" "$file" 2>/dev/null; then
                    echo "ERROR: Debug statement found in $file"
                    ERRORS=$((ERRORS + 1))
                fi
            fi
        fi
    done
fi

if [ $ERRORS -gt 0 ]; then
    echo ""
    echo "Pre-commit check failed with $ERRORS error(s). Fix the issues above and try again."
    exit 1
fi
